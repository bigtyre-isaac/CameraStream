@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    @foreach (var camera in @Model.Cameras)
    {
        <div>
            <h3>@camera.Name</h3>
            <img height="250" width="333" style="object-fit:contain;background:#111;" src="@(camera.StreamUri)" />
        </div>
    }
</div>
